<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Encuesta de Calidad - Tokisaki Kurumi Bot</title>
    <script src="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #0b0b0f;
            color: #e2e8f0;
            background-image: radial-gradient(circle at 50% 20%, #2b0c15 0%, #0b0b0f 70%);
        }
        .title-font {
            font-family: 'Cinzel', serif;
        }
        .kurumi-glow {
            box-shadow: 0 0 25px rgba(220, 38, 38, 0.3);
        }
        .kurumi-border {
            border: 1px solid rgba(220, 38, 38, 0.4);
        }
        .score-btn {
            transition: all 0.2s ease;
        }
        .score-btn:hover, .score-btn.selected {
            background-color: #dc2626;
            color: #ffffff;
            box-shadow: 0 0 15px rgba(220, 38, 38, 0.7);
            transform: scale(1.05);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-4">

    <div class="max-w-xl w-full bg-black bg-opacity-80 rounded-2xl p-6 md:p-8 kurumi-border kurumi-glow backdrop-blur-md relative overflow-hidden">
        
        <!-- Elemento decorativo estilo reloj Zafkiel -->
        <div class="absolute -top-12 -right-12 w-32 h-32 rounded-full border border-red-900 opacity-20 pointer-events-none flex items-center justify-center">
            <div class="w-24 h-24 rounded-full border border-red-600 opacity-40"></div>
        </div>

        <div class="text-center mb-6">
            <span class="text-red-500 tracking-widest text-xs uppercase font-semibold">Zafkiel System Evaluation</span>
            <h1 class="title-font text-3xl font-bold text-white mt-1">Tokisaki Kurumi Bot</h1>
            <p class="text-gray-400 text-sm mt-2">"El tiempo que pasamos juntos es precioso... Cuéntame, ¿cómo calificarías mis servicios?"</p>
        </div>

        <div id="survey-form">
            <!-- Pregunta 1 -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-300 mb-2">1. ¿Qué tan satisfecho estás con la velocidad y precisión del bot?</label>
                <div class="grid grid-cols-10 gap-1" id="q1-scores">
                    <!-- Generado por JS -->
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>1 (Muy deficiente)</span>
                    <span>10 (Excelente)</span>
                </div>
            </div>
                        <!-- Pregunta 2 -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-300 mb-2">2. ¿Qué tan útil te resulta la atención y personalización de los servicios?</label>
                <div class="grid grid-cols-10 gap-1" id="q2-scores">
                    <!-- Generado por JS -->
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>1 (Nada útil)</span>
                    <span>10 (Imprescindible)</span>
                </div>
            </div>

            <!-- Pregunta 3 -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-300 mb-2">3. En general, ¿cómo calificarías tu experiencia con Kurumi Bot?</label>
                <div class="grid grid-cols-10 gap-1" id="q3-scores">
                    <!-- Generado por JS -->
                </div>
                <div class="flex justify-between text-xs text-gray-500 mt-1">
                    <span>1 (Decepcionante)</span>
                    <span>10 (Perfecto)</span>
                </div>
            </div>

            <!-- Comentarios opcionales -->
            <div class="mb-6">
                <label for="comments" class="block text-sm font-semibold text-gray-300 mb-2">Comentarios o sugerencias para mejorar el tiempo:</label>
                <textarea id="comments" rows="3" class="w-full bg-gray-900 border border-gray-800 rounded-lg p-3 text-white focus:outline-none focus:border-red-600 text-sm" placeholder="Escribe tus observaciones aquí..."></textarea>
            </div>

            <button onclick="submitSurvey()" class="w-full bg-red-700 hover:bg-red-800 text-white font-semibold py-3 rounded-lg transition shadow-lg shadow-red-900/50 uppercase tracking-wider text-sm">
                Enviar Evaluación (¡Ara, ara!)
            </button>
        </div>
                <div id="thank-you" class="hidden text-center py-8">
            <div class="text-red-500 text-5xl mb-3">⌛</div>
            <h2 class="title-font text-2xl font-bold text-white mb-2">¡Evaluación Registrada!</h2>
            <p class="text-gray-300 text-sm mb-4" id="feedback-message">Tus respuestas han quedado grabadas en las manecillas del tiempo.</p>
            <button onclick="resetSurvey()" class="bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs px-4 py-2 rounded-lg transition">Evaluar de nuevo</button>
        </div>

    </div>

    <script>
        const scores = { q1: 0, q2: 0, q3: 0 };

        function initScoreButtons(questionId) {
            const container = document.getElementById(`${questionId}-scores`);
            for (let i = 1; i <= 10; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'score-btn bg-gray-900 border border-gray-800 text-gray-300 text-xs py-2 rounded font-semibold';
                btn.innerText = i;
                btn.onclick = () => selectScore(questionId, i);
                container.appendChild(btn);
            }
        }

        function selectScore(questionId, value) {
            scores[questionId] = value;
            const container = document.getElementById(`${questionId}-scores`);
            const buttons = container.children;
            for (let i = 0; i < buttons.length; i++) {
                if (i + 1 === value) {
                    buttons[i].classList.add('selected');
                } else {
                    buttons[i].classList.remove('selected');
                }
            }
        }

        function submitSurvey() {
            if (!scores.q1 || !scores.q2 || !scores.q3) {
                alert("Por favor, selecciona una calificación del 1 al 10 en todas las preguntas antes de enviar.");
                return;
            }

            const avg = ((scores.q1 + scores.q2 + scores.q3) / 3).toFixed(1);
            const msg = document.getElementById('feedback-message');
            
            if (avg >= 8) {
                msg.innerHTML = `¡Puntuación promedio: <b>${avg}/10</b>! Muchas gracias, tu apoyo hace que el tiempo valga la pena. ¡Ara, ara! ❤️`;
            } else if (avg >= 5) {
                msg.innerHTML = `¡Puntuación promedio: <b>${avg}/10</b>! Gracias por tus comentarios, seguiremos mejorando las manecillas de Zafkiel.`;
            } else {
                msg.innerHTML = `¡Puntuación promedio: <b>${avg}/10</b>! Tomaremos nota de cada detalle para ofrecerte un servicio superior.`;
            }

            document.getElementById('survey-form').classList.add('hidden');
            document.getElementById('thank-you').classList.remove('hidden');
        }

        function resetSurvey() {
            scores.q1 = 0; scores.q2 = 0; scores.q3 = 0;
            document.getElementById('survey-form').classList.remove('hidden');
            document.getElementById('thank-you').classList.add('hidden');
            document.getElementById('comments').value = '';
            ['q1', 'q2', 'q3'].forEach(q => {
                const container = document.getElementById(`${q}-scores`);
                Array.from(container.children).forEach(btn => btn.classList.remove('selected'));
            });
        }

        initScoreButtons('q1');
        initScoreButtons('q2');
        initScoreButtons('q3');
    </script>
</body>
</html>
